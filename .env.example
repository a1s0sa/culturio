# Remote Worker ingestion trigger
CULTURIO_WORKER_URL=https://culturio.africa
INGESTION_TRIGGER_SECRET=

# Cloudflare D1 and R2 API credentials are only needed for maintenance scripts.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=

# Cloudflare R2 S3 API (server-side ingestion only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Private ingestion bucket; public approved variants go in culturio-media via moderation.
R2_BUCKET_NAME=culturio-unpublished
R2_PUBLIC_BUCKET_NAME=culturio-media
