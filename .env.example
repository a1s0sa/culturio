# Resource limits
API_CONCURRENCY=4
DOWNLOAD_CONCURRENCY=3
PROCESS_CONCURRENCY=2
UPLOAD_CONCURRENCY=3
D1_CONCURRENCY=2
IMAGE_MAX_BYTES=31457280
IMAGE_TIMEOUT_MS=20000
IMAGE_WEBP_QUALITY=82
LOG_LEVEL=info
