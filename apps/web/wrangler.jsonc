{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "culturio",
  "main": "worker/entry.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
  "vars": {
    "PUBLIC_MUSEUM_CONSTRUCTION_NOTICE": "true",
    "PUBLIC_AUTH_ENABLED": "false"
  },
  "previews": {
    "vars": {
      "PUBLIC_MUSEUM_CONSTRUCTION_NOTICE": "false",
      "PUBLIC_AUTH_ENABLED": "true"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "culturio-preview-db",
        "database_id": "10b6d0f7-912e-45b1-8af4-470a53ac2f9e",
        "migrations_dir": "../../packages/db/migrations"
      }
    ],
    "r2_buckets": [
      { "binding": "MEDIA", "bucket_name": "culturio-preview-media" },
      { "binding": "UNPUBLISHED_MEDIA", "bucket_name": "culturio-preview-unpublished" }
    ],
    "images": { "binding": "IMAGES" },
    "observability": { "enabled": true }
    // Do not bind production queues or workflows here: previews cannot consume queues,
    // and Workflow bindings would execute the existing deployed Workflow.
  },
  "queues": {
    "producers": [
      {
        "binding": "INGEST_QUEUE",
        "queue": "culturio-ingest"
      },
      {
        "binding": "INGEST_DLQ",
        "queue": "culturio-ingest-dlq"
      }
    ],
    "consumers": [
      {
        "queue": "culturio-ingest",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 30,
        "max_concurrency": 2,
        "dead_letter_queue": "culturio-ingest-dlq"
      },
      {
        "queue": "culturio-ingest-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10
      }
    ]
  },
  "workflows": [
    {
      "name": "culturio-ingestion",
      "binding": "INGEST_WORKFLOW",
      "class_name": "IngestionWorkflow",
      "concurrency": { "limit": 5 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "culturio-db",
      "database_id": "e8467dcc-d503-4404-b7f0-547e2ac08e1a",
      "preview_database_id": "10b6d0f7-912e-45b1-8af4-470a53ac2f9e",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "culturio-media" },
    { "binding": "UNPUBLISHED_MEDIA", "bucket_name": "culturio-unpublished" }
  ],
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true }
}
