{
  "extends": "$app/tsconfig",
  "include": ["src", "tests", "*.ts"],
  "exclude": ["src/service-worker", "worker-configuration.d.ts", ".svelte-kit"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "paths": { "$lib": ["./src/lib"], "$lib/*": ["./src/lib/*"] }
  }
}
