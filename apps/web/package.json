{
  "name": "@culturio/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "dev:worker": "pnpm build && wrangler dev --config wrangler.jsonc",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check src",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@culturio/db": "workspace:*",
    "@culturio/shared": "workspace:*",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
    "@threlte/core": "^8.6.1",
    "better-auth": "^1.7.20",
    "country-flag-icons": "^1.6.20",
    "svelte": "^5.57.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "@playwright/test": "^1.56.1",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "prettier": "^3.9.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
